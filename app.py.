    })
    fig = px.bar(comparisons, x='Category', y='USD', color='Category', text='USD', color_discrete_sequence=PALETTE)
    fig.update_traces(texttemplate='$%{text:,.0f}', textposition='outside')
    fig.update_layout(showlegend=False, xaxis_title='', yaxis_title='Simulated USD')
    chart(fig)

