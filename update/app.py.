# ==========================================
# 6. FINANCIAL IMPACT
# ==========================================

elif page == "Financial Impact & Working Capital":

    st.header("Financial Impact & Working Capital")

    st.caption(
        "Financial scenario analysis using simulated data."
    )

    st.subheader("Financial Assumptions")

    c1, c2, c3 = st.columns(3)

    with c1:
        unit_cost = st.number_input(
            "Unit Acquisition Cost ($)",
            min_value=0.0,
            value=45.0,
            step=1.0
        )

    with c2:
        selling_price = st.number_input(
            "Selling Price ($)",
            min_value=0.0,
            value=129.0,
            step=1.0
        )

    with c3:
        holding_rate = st.slider(
            "Annual Holding Cost (%)",
            min_value=0,
            max_value=50,
            value=20
        )

    available_units = p["available_stock"].sum()
    proposed_units = o["recommended_units"].sum()
    unmet_units = spike["unmet_demand"].sum()

    inventory_value = available_units * unit_cost
    purchase_investment = proposed_units * unit_cost

    revenue_exposure = unmet_units * selling_price

    holding_cost = (
        inventory_value
        * holding_rate / 100
        * 30 / 365
    )

    transfer_cost = a["estimated_transfer_cost"].sum()

    st.subheader("Financial Performance Indicators")

    c1, c2, c3 = st.columns(3)

    c1.metric(
        "Available Inventory Value",
        money(inventory_value)
    )

    c2.metric(
        "Proposed PO Investment",
        money(purchase_investment)
    )

    c3.metric(
        "Potential Sales Exposure",
        money(revenue_exposure)
    )

    c4, c5 = st.columns(2)

    c4.metric(
        "30-Day Inventory Holding Cost",
        money(holding_cost)
    )

    c5.metric(
        "FBA Transfer Cost",
        money(transfer_cost)
    )

    financial_summary = pd.DataFrame({
        "metric": [
            "Available Inventory Value",
            "Proposed PO Investment",
            "Revenue at Risk - Demand Spike",
            "30-Day Inventory Carrying Cost",
            "FBA Transfer Cost"
        ],
        "amount_usd": [
            inventory_value,
            purchase_investment,
            revenue_exposure,
            holding_cost,
            transfer_cost
        ]
    })

    st.subheader("Financial Impact Overview")

    fig = px.bar(
        financial_summary,
        x="amount_usd",
        y="metric",
        orientation="h",
        color="metric",
        title="Financial Impact Analysis",
        labels={
            "amount_usd": "USD",
            "metric": "Financial Metric"
        }
    )

    show_chart(fig)

    st.dataframe(
        financial_summary,
        hide_index=True,
        use_container_width=True
    )

