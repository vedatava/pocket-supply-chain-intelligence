@st.cache_data
def load_data(name):
    path = DATA / f"{name}.csv"

    if not path.exists():
        st.error(f"Missing file: data/{name}.csv")
        st.stop()

    return pd.read_csv(path)


forecast = load_data("demand_forecast")
backtest = load_data("forecast_backtest")
planning = load_data("inventory_planning")
orders = load_data("purchase_orders")
scenarios = load_data("scenario_summary")
mitigation = load_data("risk_mitigation")
fba = load_data("fba_replenishment")
allocation = load_data("fba_allocation")
warehouse = load_data("warehouse_inventory")
fulfillment = load_data("fulfillment_performance")
projection = load_data("inventory_projection")

forecast["week"] = pd.to_datetime(forecast["week"])
projection["date"] = pd.to_datetime(projection["date"])


def money(value):
    return f"${value:,.0f}"


def number(value):
    return f"{value:,.0f}"


def show_chart(fig):
    fig.update_layout(
        template="plotly_white",
        margin=dict(l=10, r=10, t=45, b=20)
    )
    st.plotly_chart(fig, use_container_width=True)


st.sidebar.title("📦 POCKET / OPS LAB")
st.sidebar.caption("Independent Supply Chain Analytics")

page = st.sidebar.radio(
    "Navigation",
    [
        "Executive Overview",
        "Demand Forecast",
        "Inventory & Purchase Orders",
        "Amazon FBA & Warehouses",
        "Fulfillment & Costs",
        "Financial Impact & Working Capital",
        "Methodology & Limitations"
    ]
)

sku_options = ["All products"] + sorted(
    planning["sku"].dropna().unique().tolist()
)

selected_sku = st.sidebar.selectbox(
    "Product / Colorway",
    sku_options
)


def filter_sku(data):
    if selected_sku != "All products" and "sku" in data.columns:
        return data[data["sku"] == selected_sku].copy()
    return data.copy()


f = filter_sku(forecast)
b = filter_sku(backtest)
p = filter_sku(planning)
o = filter_sku(orders)
s = filter_sku(scenarios)
m = filter_sku(mitigation)
fb = filter_sku(fba)
a = filter_sku(allocation)
w = filter_sku(warehouse)
proj = filter_sku(projection)

ma = b[b["model"] == "4-Week Moving Average"]

if not ma.empty and ma["actual"].sum() > 0:
    wape = (
        ma["absolute_error"].sum()
        / ma["actual"].sum()
        * 100
    )
else:
    wape = 0

baseline = s[s["scenario"] == "Baseline"]
spike = s[s["scenario"] == "30% Demand Spike"]
delay = s[s["scenario"] == "7-Day Supplier Delay"]


st.title("Pocket | Supply Chain Intelligence")

st.caption(
    "Executive Decision Support | Demand Forecasting | "
    "Inventory Optimization | Amazon FBA | Fulfillment"
)

st.info(
    "Independent portfolio project using 100% simulated data. "
    "Not affiliated with Pocket. "
    "Forecast WAPE applies to a one-week-ahead backtest, "
    "not the 12-week forecast."
)


