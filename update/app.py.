    )

    weekly = (
        f.groupby(["week", "channel"], as_index=False)
        ["forecast_units"].sum()
    )

    fig = px.line(
        weekly,
        x="week",
        y="forecast_units",
        color="channel",
        markers=True,
        title="Weekly Demand Forecast by Channel"
    )

    show_chart(fig)

    st.subheader("Forecast Model Comparison")

    comparison = (
        b.groupby("model", as_index=False)
        .agg(
            actual=("actual", "sum"),
            error=("absolute_error", "sum")
        )
    )

    comparison["WAPE (%)"] = (
        comparison["error"]
        / comparison["actual"]
        * 100
    )

    fig = px.bar(
        comparison,
        x="model",
        y="WAPE (%)",
        color="model",
        text="WAPE (%)"
    )

    show_chart(fig)

    st.warning(
        "The 12-week forecast is a fixed moving-average "
        "baseline. The reported WAPE does not establish "
        "12-week forecasting accuracy."
    )

    st.dataframe(f, hide_index=True, use_container_width=True)


