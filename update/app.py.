elif page == "Demand Forecast":

    st.header("12-Week Demand Forecast")

    c1, c2, c3 = st.columns(3)

    c1.metric(
        "Total Forecast",
        number(f["forecast_units"].sum())
    )

    c2.metric(
        "Historical 1-Week WAPE",
