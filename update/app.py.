        s.groupby("scenario", as_index=False)
        ["unmet_demand"].sum()
    )

    fig = px.bar(
        risk_data,
        x="scenario",
        y="unmet_demand",
        color="scenario"
    )

    show_chart(fig)

    st.subheader("Priority Purchase Orders")
    st.dataframe(o, hide_index=True, use_container_width=True)


