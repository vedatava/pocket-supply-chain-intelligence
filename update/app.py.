    )

    c3.metric(
        "Baseline Unmet Demand",
        number(baseline["unmet_demand"].sum())
    )

    c4.metric(
        "Demand Spike Exposure",
        number(spike["unmet_demand"].sum())
    )

    st.subheader("Executive Decision Brief")

    if spike["unmet_demand"].sum() > 0:
        st.error(
            "HIGH PRIORITY: A 30% demand spike could "
            f"create {number(spike['unmet_demand'].sum())} "
            "units of unmet demand in this simulation."
        )

    if not w.empty:
        lowest = w.sort_values("coverage_days").iloc[0]

        st.warning(
            "WAREHOUSE WATCH: "
            f"{lowest['warehouse_id']} / {lowest['sku']} "
            f"has {lowest['coverage_days']:.2f} "
            "days of post-transfer coverage."
        )

    if baseline["unmet_demand"].sum() == 0:
        st.success(
            "BASELINE: The proposed replenishment plan "
            "meets demand in the deterministic simulation."
        )

    st.subheader("12-Week Demand by Channel")

    channel_forecast = (
        f.groupby("channel", as_index=False)
        ["forecast_units"].sum()
    )

    fig = px.bar(
        channel_forecast,
        x="channel",
